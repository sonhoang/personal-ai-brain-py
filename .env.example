# Environment variables read by `brain`. The app does not load this file itself:
# export them in your shell, or use `uv run --env-file .env brain ...`. Only `brain ask`, `brain eval --answers`
# and the MCP ask_library tool need the API key; ingest, search and notes work without it.
ANTHROPIC_API_KEY=

# Where the SQLite library lives. Use an absolute path when an MCP client starts the server.
BRAIN_DB=brain.db

# Claude model used for answers.
BRAIN_MODEL=claude-sonnet-5-5

# Number of retrieved chunks sent to the model per question.
BRAIN_TOP_K=6
